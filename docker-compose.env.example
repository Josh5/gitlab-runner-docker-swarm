#@ Placement
#-    Configure a placement constraint to where the container will be run.
#-    Examples:
#-        - node.hostname==<hostname>
#-        - engine.labels.fs-access.<worker-hostname>.mnt==true
#-        - node.role!=manager
PLACEMENT_CONSTRAINT=engine.labels.node-type==gitlab-runner
#-  - DATA_PATH -
#-    The path to the directory where cache storage will be written
DATA_PATH=/opt/gitlab-runner
#-  - DIND_CONTAINER_NAME -
#-    Host Docker container name for DinD; use a unique name per stack on the same host
DIND_CONTAINER_NAME=gitlab-runner-dind
#-  - DIND_NETWORK_NAME -
#-    Host Docker network for DinD and the runner; use a unique name per stack on the same host
DIND_NETWORK_NAME=gitlab-runner-net
#-  - GITLAB_RUNNER_VERSION -
#-    Specify a specific version of GitLab Runner to use
#-    Releases:
#-      https://gitlab.com/gitlab-org/gitlab-runner/-/releases
#-      https://hub.docker.com/r/gitlab/gitlab-runner/tags
GITLAB_RUNNER_VERSION=v19.4.1
#-  - GITLAB_REGISTRATION_TOKEN_SECRET -
#-    Name of the existing Docker secret containing the runner authentication token
GITLAB_REGISTRATION_TOKEN_SECRET=GITLAB_REGISTRATION_TOKEN_SECRET
#-  - RUNNER_NAME -
#-    Configure the GitLab Runner name
RUNNER_NAME=swarm-gitlab-runner
#-  - RUNNER_CONCURRENCY -
#-    GitLab Runner concurrency (max number of jobs it can process at the same time)
RUNNER_CONCURRENCY=2
#-  - DOCKER_IMAGE -
#-    Default docker image used by runner jobs
DOCKER_IMAGE=docker
#-  - DOCKER_PULL_POLICY -
#-    Default job image pull policy: always, if-not-present, or never.
DOCKER_PULL_POLICY=if-not-present
#-  - DOCKER_ALLOWED_PULL_POLICIES -
#-    Comma-separated policies jobs may request (no spaces).
#-    Must include DOCKER_PULL_POLICY.
DOCKER_ALLOWED_PULL_POLICIES=always,if-not-present
#-  - KEEP_ALIVE -
#-    Keep services alive between restarts (will still recreate if the configuration updates)
KEEP_ALIVE=true
